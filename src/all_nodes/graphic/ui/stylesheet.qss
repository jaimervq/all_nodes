/* ---------------------------- QWidget ---------------------------- */
QWidget
{
	background-color: #303340;
	color: #fff;
}

/* ---------------------------- QInputDialog  ---------------------------- */
QInputDialog
{
	background-color: #303340;
	color: red;
}

/* ---------------------------- QMenuBar ---------------------------- */
QMenuBar::item{
	background-color: transparent;
}
QMenuBar::item:selected{
	background-color: rgba(240, 100, 10, 25);
}

QMenuBar:disabled{
	background-color: #303340;
	color: dark-gray;
}

/* ---------------------------- QMenu ---------------------------- */
QMenu
{
	color: #fff;
}

QMenu::item
{
    background-color: #303340;

}

QMenu::item:selected
{
    border:2px solid #eb7a02;
}

/* ---------------------------- QGraphicsView ---------------------------- */
QGraphicsView
{
background-color: rgba(0,0,0,50%);
}

/* ---------------------------- QToolTip ---------------------------- */
QToolTip
{
	background-color: #303340;
	color: #fff;
    border:1px solid #404040;
}

/* ---------------------------- QLineEdit ---------------------------- */
QLineEdit
{
	background-color: rgba(10,12,20,190);
	color: white;
    border: 1px solid #404040;
	border-radius: 2px;
	padding: 3px;
	padding-left: 5px;
}

/* ---------------------------- QPushButton ---------------------------- */
QPushButton
{
    background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:0, y2:1, stop:0 rgba(60,60,60,255), stop:0.2 rgba(100,100,110,255), stop:1 rgba(20,20,20,255));
    border:1px solid black;
    border-radius: 4px;
	padding: 5px;
	padding-left: 15px;
	padding-right: 15px;

}

QPushButton:hover
{
    border:2px solid #eb7a02;
    border-radius: 4px;

}


/* ---------------------------- QTabWidget ---------------------------- */
QTabBar::tab
{
	background-color: transparent;
	color: #ffffff;
	border-style: solid;
	border-width: 1px;
	border-color: #666;
	border-bottom: none;
	padding: 5px;
	padding-left: 30px;
	padding-right: 30px;
}

QTabBar::tab:!selected
{
	color: #b1b1b1;
	border-bottom-style: solid;
    top: 2px;
}

QTabBar::tab:selected
{
    background-color: #0c0c0d;
    color:#eb7a02;
	margin-bottom: 0px;
}

QTabWidget::pane
{
	border: 1px solid #404040;
}

/* ---------------------------- QTreeView ---------------------------- */
QTreeView::branch:closed:has-children
{
	image: url("icons:plus.svg");
}

QTreeView::branch:open:has-children
{
	image: url("icons:expand.svg");
}

QTreeView::item:hover
{
	color: #fff;
	border:1px dashed #eb7a02;
	margin-right:10px;
}

QTreeView::item:selected, QTreeView::item:hover:selected
{
	color: #fff;
	border:2px solid #eb7a02;
	margin-right:10px;
}

/* ---------------------------- QListWidget ---------------------------- */
QListWidget::item:selected, QListWidget::item:hover:selected
{
	color: #fff;
	border:2px solid #eb7a02;
	margin-right:10px;
}

/* ---------------------------- QLabel ---------------------------- */
QLabel
{
	background-color: transparent;
}

/* ---------------------------- TABLE VIEW ---------------------------- */

QTableView
{
    background-color: #2b2e3a;
    gridline-color: #404040;
    selection-background-color: rgba(235,122,2,60);
    selection-color: white;
    border: 1px solid #404040;
}

/* remove ugly focus rectangle */
QTableView::item:focus
{
    outline: none;
}

/* ---------------------------- HEADER ---------------------------- */

QHeaderView
{
    background-color: #262933;
}

/* main header sections */
QHeaderView::section
{
    background-color: #262933;
    color: #d6d6d6;
    padding: 4px;
    border: 1px solid #404040;
}

/* hover */
QHeaderView::section:hover
{
    background-color: #2f3340;
}

/* pressed (when resizing) */
QHeaderView::section:pressed
{
    background-color: #eb7a02;
    color: white;
}

/* remove ugly corner square */
QTableCornerButton::section
{
    background-color: #262933;
    border: 1px solid #404040;
}

/* ---------------------------- QComboBox ---------------------------- */
QComboBox
{
    background-color: rgba(0,0,0,100);
    color: white;
    border: 1px solid #10111494;
    border-radius: 2px;
    padding: 3px;
    padding-left: 6px;
    padding-right: 6px;
}

QComboBox::drop-down
{
    border: none;
    background: transparent;
    width: 18px;
}

QComboBox::down-arrow {
    image: url("icons:dropdown.svg");
    width: 12px;
    height: 12px;
}

QComboBox:enabled:hover
{
    border: 1px solid #eb7a02;
}


QComboBox:focus
{
    border: 1px solid #eb7a02;
}


QComboBox QAbstractItemView
{
    background-color: #303340;
    color: white;
    border: 1px solid #404040;
    selection-background-color: rgba(235,122,2,60);
    selection-color: white;
}

QComboBox QAbstractItemView::item:hover
{
    border: 1px dashed #eb7a02;
}

QComboBox QAbstractItemView::item:selected
{
    border: 2px solid #eb7a02;
}

/* ---------------------------- QDockWidget ---------------------------- */
QDockWidget::title {
    background: rgba(0,0,0,100);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QDockWidget {
    padding-right: 8px;
    padding-top: 4px;
	margin-right:10px;

}

/* ---------------------------- QToolButton ---------------------------- */
QToolButton
{
	background-color: transparent;
	color: #fff;
	border:none;
	padding: 4px;
}

QToolButton:hover
{
	background-color: rgba(183, 134, 32, 30);
	border: 1px solid #b36500;
}

QToolButton:pressed
{
	background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:0, y2:1, stop:0 rgba(0,0,0,150), stop:0.2 rgba(0,0,0,0), stop:0.8 rgba(0,0,0,0), stop:1 rgba(0,0,0,150));
	border: 1px solid #b36500;
}

/* ---------------------------- QScrollArea ---------------------------- */
QScrollArea {
    border: none;
    background: transparent;
}

/* ---------------------------- QScrollBar ---------------------------- */
QScrollBar:vertical
{
background-color: transparent;
width: 8px;
}

QScrollBar::handle:vertical
{
border: 0px solid red;
border-radius:4px;
background: #eb7a02;
min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical
{
background-color: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical
{
background-color: transparent;
}

QScrollBar:horizontal
{
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal
{
    border-radius:4px;
    background: #eb7a02;
    min-width: 20px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal
{
    background-color: transparent;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal
{
    background-color: transparent;
}